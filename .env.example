# The scaffold runs with mocks when these are absent.
USE_MOCK_SERVICES=true
USE_MOCK_BRIGHT_DATA=
USE_MOCK_MOSS=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=myminion-agent
BUYWISE_API_URL=http://localhost:8787
BRIGHT_DATA_API_KEY=
BRIGHT_DATA_SERP_ZONE=
BRIGHT_DATA_UNLOCKER_ZONE=
BRIGHT_DATA_BROWSER_WS=
BRIGHT_DATA_TIMEOUT_SECONDS=30
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_AUTO_CREATE_INDEXES=true
# Optional: when USE_MOCK_MOSS is true, set this to persist mock data to local JSON
# files instead of pure in-memory (survives a process restart, e.g. if the real Moss
# SDK isn't installable on your platform).
MOSS_LOCAL_STORAGE_PATH=
NEXT_PUBLIC_AGENT_API_URL=http://localhost:8000
